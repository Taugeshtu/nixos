#!/usr/bin/env bash
set -euo pipefail

PROJECTS_DIR="/home/tau/10_PROJECTS"
ARCHIVE_DIR="10_PROJECTS/_archive"
TOWER_HOST="Tower"
MUTAGEN_PROJECTS_DIR="/home/tau/.config/mutagen/projects"

usage() {
    echo "Usage: prj activate <NAME>"
    echo "       prj deactivate [NAME]"
    exit 1
}

check_tower() {
    if ! ssh -o BatchMode=yes -o ConnectTimeout=3 "$TOWER_HOST" true 2>/dev/null; then
        echo "Error: Tower is unreachable via SSH." >&2
        exit 1
    fi
}

cmd="${1:-}"
case "$cmd" in
    activate)
        name="${2:-}"
        if [ -z "$name" ] || [ "$name" = "_archive" ] || [[ "$name" == *"/"* ]]; then
            echo "Error: valid project name required for activate." >&2
            exit 1
        fi

        check_tower

        local_path="$PROJECTS_DIR/$name"
        clean_name="$(echo "$name" | sed 's/[^a-zA-Z0-9]/-/g; s/^-*//; s/-*$//')"
        project_name="prj-${clean_name,,}"
        project_yaml="$MUTAGEN_PROJECTS_DIR/$project_name.yml"

        if ssh "$TOWER_HOST" "test -d '$ARCHIVE_DIR/$name'"; then
            if ssh "$TOWER_HOST" "test -e '10_PROJECTS/$name'"; then
                echo "Error: 10_PROJECTS/$name already exists on $TOWER_HOST (collision)" >&2
                exit 1
            fi
            echo "==> Moving $name out of archive on $TOWER_HOST..."
            ssh "$TOWER_HOST" "mv '$ARCHIVE_DIR/$name' '10_PROJECTS/$name'"
        elif ! ssh "$TOWER_HOST" "test -d '10_PROJECTS/$name'"; then
            echo "Error: $name not found in 10_PROJECTS or $ARCHIVE_DIR on $TOWER_HOST" >&2
            exit 1
        fi

        echo "==> Ensuring local directory $local_path..."
        mkdir -p "$local_path"

        mkdir -p "$MUTAGEN_PROJECTS_DIR"
        echo "==> Creating Mutagen project config $project_yaml..."
        cat <<EOF > "$project_yaml"
sync:
  $project_name:
    alpha: "$local_path"
    beta: "$TOWER_HOST:10_PROJECTS/$name"
EOF

        echo "==> Starting Mutagen project $project_name..."
        mutagen project start -f "$project_yaml"

        echo "==> Flushing initial sync..."
        mutagen project flush -f "$project_yaml" || true

        echo "==> Project $name activated successfully."
        ;;

    deactivate)
        name="${2:-}"
        if [ -z "$name" ]; then
            cwd="$(pwd -P)"
            if [[ "$cwd" == "$PROJECTS_DIR/"* ]]; then
                rel="${cwd#"$PROJECTS_DIR/"}"
                name="${rel%%/*}"
            fi
        fi

        if [ -z "$name" ] || [ "$name" = "_archive" ] || [[ "$name" == *"/"* ]]; then
            echo "Error: valid project name required for deactivate." >&2
            exit 1
        fi

        local_path="$PROJECTS_DIR/$name"
        if [ ! -d "$local_path" ]; then
            echo "Error: local directory $local_path not found." >&2
            exit 1
        fi

        check_tower

        if ssh "$TOWER_HOST" "test -e '$ARCHIVE_DIR/$name'"; then
            echo "Error: target $ARCHIVE_DIR/$name already exists on $TOWER_HOST (collision)" >&2
            exit 1
        fi

        clean_name="$(echo "$name" | sed 's/[^a-zA-Z0-9]/-/g; s/^-*//; s/-*$//')"
        project_name="prj-${clean_name,,}"
        project_yaml="$MUTAGEN_PROJECTS_DIR/$project_name.yml"

        if [ -f "$project_yaml" ]; then
            echo "==> Flushing Mutagen project $project_name..."
            mutagen project flush -f "$project_yaml" || true
            echo "==> Terminating Mutagen project $project_name..."
            mutagen project terminate -f "$project_yaml"
            rm -f "$project_yaml"
        elif mutagen sync list "$project_name" >/dev/null 2>&1; then
            echo "==> Terminating loose Mutagen session $project_name..."
            mutagen sync terminate "$project_name"
        else
            echo "==> No active Mutagen session ($project_name). Syncing to $TOWER_HOST via rsync..."
            rsync -avz --delete "$local_path/" "$TOWER_HOST:10_PROJECTS/$name/"
        fi

        echo "==> Moving $name to archive on $TOWER_HOST..."
        ssh "$TOWER_HOST" "mv '10_PROJECTS/$name' '$ARCHIVE_DIR/$name'"

        echo "==> Removing local copy $local_path..."
        cd "$PROJECTS_DIR"
        if [[ "$local_path" == "$PROJECTS_DIR/"* ]] && [ -n "$name" ]; then
            rm -rf "$local_path"
        fi

        echo "==> Project $name deactivated and archived on $TOWER_HOST."
        ;;

    thunar-deactivate)
        target="${2:-}"
        dir="$(dirname "$target")"
        base="$(basename "$target")"
        if [ "$dir" != "$PROJECTS_DIR" ]; then
            echo "Error: deactivate only works on projects directly in $PROJECTS_DIR"
            echo "Target was: $target"
            echo
            read -p "Press Enter to exit..."
            exit 1
        fi
        "$0" deactivate "$base"
        echo
        read -p "Press Enter to exit..."
        ;;

    thunar-activate)
        target="${2:-}"
        dir="$(dirname "$target")"
        base="$(basename "$target")"
        if [ "$dir" != "$PROJECTS_DIR/_archive" ] && [ "$dir" != "$PROJECTS_DIR" ]; then
            echo "Error: activate only works on projects in $PROJECTS_DIR or $PROJECTS_DIR/_archive"
            echo "Target was: $target"
            echo
            read -p "Press Enter to exit..."
            exit 1
        fi
        "$0" activate "$base"
        echo
        read -p "Press Enter to exit..."
        ;;

    *)
        usage
        ;;
esac
