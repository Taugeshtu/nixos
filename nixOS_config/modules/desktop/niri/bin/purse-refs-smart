#!/usr/bin/env bash

XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

# If current.sock has active file (we have definitions)
if [ -S "$XDG_RUNTIME_DIR/current.sock" ] && \
     CONTEXT=$(echo '{"type": "Query"}' | nc -w 1 -U "$XDG_RUNTIME_DIR/current.sock" 2>/dev/null) && \
     FILE=$(echo "$CONTEXT" | jq -r '.attention.file' 2>/dev/null) && \
     [ -n "$FILE" ] && [ "$FILE" != "null" ]; then
    # Otherwise, launch gluek-up in definitions mode
    /home/tau/.local/bin/purse-refs.sh &
else
    # Fall through to active application
    # wtype does not route to XWayland clients, so use xdotool if X11 window is active
    if xdotool getactivewindow >/dev/null 2>&1; then
        xdotool key --clearmodifiers alt+Return
    else
        wtype -M alt -k return -m alt
    fi
fi

